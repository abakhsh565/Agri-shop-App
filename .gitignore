node_modules/
dist/
build/
.cache/
.env*
# The template is the one env file that belongs in the repository: it carries the variable NAMES
# an environment must set, and no values. Without this exception `.env*` silently ignored it.
!.env.example
.vite/
vite.config.*.timestamp-*
*.tsbuildinfo
*-debug.log*
logs/
*.log
.claude-replay.*
.tmp-*

# Local machine artifacts. Four debug APKs and a directory of preview logs were sitting
# untracked in the tree; the build output is reproducible and the logs are this machine's,
# so neither belongs in a commit.
/.freebuff/
*.apk
/test-results/
/dist-bundle/

# Generated knowledge-graph artifacts (graphify). Each snapshot's graph.json is ~8 MB and the
# repository carried two of them. Rebuild with `graphify .` when the graph is needed.
/graphify-out/

# Archives of source or assets. `Guide for App Development final.zip` (8.6 MB) sat in the root;
# the source it wrapped was already in the repository.
*.zip

# Logical database dumps from scripts/backup-database.mjs. A dump holds every row of every table:
# real customers, orders and phone numbers. It is machine output, never source.
/backups/


# Capacitor native projects — generated locally with `npx cap add`
/android/
/ios/

# Android signing keys. The release keystore is the app's identity: anyone who has it can
# publish an APK that Android accepts as an update to the installed app. It lives in GitHub
# secrets (see .github/inject-signing.cjs) and must never reach a commit.
*.jks
*.keystore
*.p12
/keystore/
/freebuff-sites-build/
