{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "assistant:dev": "node ai-assistant/server/dev.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "cap:sync": "vite build && cap sync",
    "brand:assets": "node scripts/brand/build-brand-assets.mjs",
    "brand:android": "capacitor-assets generate --android",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "registry:build": "node scripts/scan-frontend-deps.cjs && node scripts/dev/index.mjs && vitest run tests/unit/featureRegistryGuard.test.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:e2e": "npx playwright test",
    "test:e2e:lanes": "node scripts/run-e2e-lanes.mjs",
    "test:all": "vitest run && npx playwright test",
    "resume": "node scripts/dev/state.mjs resume",
    "checkpoint": "node scripts/dev/state.mjs checkpoint",
    "preflight": "node scripts/dev/preflight.mjs",
    "verify": "node scripts/dev/verify.mjs",
    "verify:plan": "node scripts/dev/verify.mjs --plan",
    "verify:full": "node scripts/dev/verify.mjs --tier 2 --no-cache",
    "lane:new": "node scripts/dev/new-lane.mjs",
    "qa:count": "node scripts/dev/qa.mjs count",
    "qa:baseline": "node scripts/dev/qa-baseline.mjs",
    "qa:clean": "node scripts/dev/qa.mjs clean",
    "qa:seed": "node scripts/dev/qa.mjs seed",
    "migrate": "node scripts/migrate.mjs",
    "migrate:status": "node scripts/migrate.mjs status --env staging",
    "migrate:verify": "node scripts/migrate.mjs verify --env staging",
    "backup": "node scripts/backup-database.mjs",
    "backup:verify": "node scripts/restore-verify.mjs",
    "audit:production-data": "node scripts/audit-production-data.mjs",
    "verify:cleanup-runbook": "node scripts/verify-cleanup-runbook.mjs",
    "creds:production": "node scripts/run-with-production-credentials.mjs",
    "verify:targeting": "node scripts/verify-targeting-refusals.mjs",
    "verify:isolation": "node scripts/verify-environment-isolation.mjs",
    "local:db": "node scripts/dev/local-db.mjs",
    "verify:credentials": "node scripts/verify-credential-intake.mjs",
    "verify:workflow": "node scripts/verify-workflow-safety.mjs",
    "verify:baseline": "node scripts/verify-forward-on-baseline.mjs",
    "rehearse:engine": "node scripts/dev/rehearse-on-local-engine.mjs",
    "extract:functions": "node scripts/dev/extract-missing-functions.mjs",
    "rehearse:restore": "node scripts/dev/rehearse-restore-local-engine.mjs",
    "index:build": "node scripts/dev/index.mjs",
    "rehearse:flows": "node scripts/rehearse-production-flows.mjs",
    "measure:production-final-state": "node scripts/measure-production-final-state.mjs",
    "probe:isolation": "node scripts/dev/probe-two-shop-isolation.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^9.1.2",
    "@capacitor-mlkit/barcode-scanning": "^7.5.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.8",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@supabase/supabase-js": "^2.112.3",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^6.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/ios": "^7.6.8",
    "@electric-sql/pglite": "^0.5.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "agentation": "^3.0.2",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "oxfmt": "^0.2.0",
    "pg": "^8.23.0",
    "supabase": "^2.115.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
