# AgriShop environment template — NAMES ONLY, never values.
#
# Copy to `.env.local` (development) or `.env.staging` / `.env.production` and fill in that
# environment's own project. All real env files are gitignored; this one is committed on purpose
# so the required names are discoverable and a new environment cannot silently miss one.
#
# The rules these values must satisfy live in src/lib/environmentContract.ts and are enforced
# twice: at build time (vite.config.ts refuses to build) and at start-up (src/lib/envGuard.ts
# refuses to run). Read that file before adding a variable.

# ── Which environment this build belongs to ────────────────────────────────────────────────
# Exactly one of: development | staging | production
# There is no default. An unset or misspelled value fails the build. Uppercase is rejected on
# purpose: "PRODUCTION" is a typo, not a dialect.
VITE_APP_ENV=

# ── The database this build talks to ───────────────────────────────────────────────────────
# This environment's OWN Supabase project. Never another environment's.
#   development → must not be the production project
#   staging     → must be the staging project
#   production  → must be the production project
# Set either the URL or the project id; the URL wins if both are present.
VITE_SUPABASE_URL=https://<this-environments-project-ref>.supabase.co
VITE_SUPABASE_PROJECT_ID=<this-environments-project-ref>

# This environment's anon/publishable key.
# NEVER put a service_role key here: this file's values are compiled into the browser bundle and
# into the APK. The publishable key is safe to ship; the service-role key is not, ever.
VITE_SUPABASE_ANON_KEY=

# ── How sign-in codes are delivered ────────────────────────────────────────────────────────
#   sms  → real codes from the Supabase phone provider. REQUIRED for production.
#   demo → the shared code is accepted. Allowed in development and staging only.
# Production with anything other than `sms` fails the build and refuses to start: accepting a
# shared code for any phone number is a login bypass, not a convenience.
VITE_OTP_DELIVERY=

# ── Optional ───────────────────────────────────────────────────────────────────────────────
# Public base URL, used to build shareable invitation links.
VITE_APP_URL=

# ── Error reporting (optional; staging and production only) ────────────────────────────────
# The Sentry DSN for this environment's project. A DSN is a write-only public ingest address, so
# it is safe in the browser bundle — but it is still configuration, not a constant: leaving it
# unset disables notification entirely and errorReportingStatus() says so. The private record in
# client_error_events keeps working either way.
VITE_SENTRY_DSN=

# Report development errors too. Leave unset: development noise is the developer's, not the team's.
VITE_SENTRY_DEV=

# The release id (commit sha) every event is tagged with. Normally injected by vite.config.ts from
# VERCEL_GIT_COMMIT_SHA / GITHUB_SHA; set it only to pin a release by hand.
VITE_RELEASE=

# The source-map upload token is a CI secret, never an app variable: SENTRY_AUTH_TOKEN (secret),
# SENTRY_ORG and SENTRY_PROJECT (repository variables). See docs/MONITORING.md §2.
